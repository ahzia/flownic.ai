# Copy to .env.local for development. Never commit real secrets.
# Preview/production must use separate Supabase, LiveKit, email, and payment projects.

NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=local

# Supabase (EU region recommended)
# Use new publishable + secret keys (anon/service_role are deprecated).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LiveKit Cloud
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI (server only)
OPENAI_API_KEY=
AI_FOLLOWUP_MODEL=gpt-4.1-mini
AI_FEEDBACK_MODEL=gpt-4.1
AI_REALTIME_MODEL=gpt-4o-realtime-preview
AI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Email (optional until notifications ship)
RESEND_API_KEY=
EMAIL_FROM=

# Optional
SENTRY_DSN=
PAYMENT_LINK_URL=
STAFF_EMAIL_ALLOWLIST=
DEFAULT_TIMEZONE=Europe/Berlin
DATA_RETENTION_POLICY_VERSION=2026-07-01
CONSENT_POLICY_VERSION=2026-07-01

# Feature flags (1/true/yes/on)
FEATURE_PEER_SESSIONS_ENABLED=true
FEATURE_AI_FALLBACK_ENABLED=true
FEATURE_LIVE_TRANSCRIPTION_ENABLED=true
FEATURE_EXAMINER_FOLLOWUPS_ENABLED=true
FEATURE_VIDEO_ENABLED=true
FEATURE_PILOT_RECORDING_ENABLED=false
FEATURE_PAYMENT_OFFER_ENABLED=false
FEATURE_REPORT_HUMAN_REVIEW_REQUIRED=true
